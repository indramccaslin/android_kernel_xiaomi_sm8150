# Platform
CONFIG_MACH_XIAOMI_CEPHEUS=y

# Audio
CONFIG_SND_SOC_CS35L41=y
CONFIG_MSM_CSPL=y

# Camera
CONFIG_VCM_AK7374=y

# Power
CONFIG_IDT_P9220=y

# Touchscreen
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_FTS_FOD_AREA_REPORT=y
CONFIG_SECURE_TOUCH=y
CONFIG_I2C_BY_DMA=y
CONFIG_TOUCHSCREEN_COMMON=Y

# Default governor: schedutil (hemat baterai).
# CPU clock MAX tidak dipin di kernel; diatur module gaming saat game dibuka.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
